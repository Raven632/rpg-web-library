# Игнорируем установленные модули (они должны ставиться внутри контейнера через RUN npm install)
node_modules/

# Игнорируем логи npm
npm-debug.log
npm-debug.log.*
*.log

# Игнорируем локальные переменные окружения (секреты должны пробрасываться через docker-compose или CI/CD)
.env

# Системные файлы
.DS_Store
Thumbs.db

