[Unit]
Description=RPG Library: pull-деплой из GitHub
Wants=network-online.target
After=network-online.target docker.service

[Service]
Type=oneshot
# git берёт safe.directory из ~/.gitconfig, а у системных сервисов $HOME пустой
Environment=HOME=/root
ExecStart=/root/rpgm/deploy/pull-deploy.sh
# У oneshot таймаута по умолчанию нет: зависшая сборка висела бы вечно
TimeoutStartSec=30min